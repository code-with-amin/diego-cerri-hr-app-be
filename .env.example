# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_app?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Seeded admin (single HR manager account)
ADMIN_EMAIL=admin@kpi.com
ADMIN_PASSWORD=change-me-strong

# AWS S3 (resume storage — private bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=kpi-hr-resumes

# CORS — comma-separated allowed origins (candidate form + admin dashboard)
CORS_ORIGIN=http://localhost:5500,http://localhost:5173

# Uploads
MAX_UPLOAD_MB=10
