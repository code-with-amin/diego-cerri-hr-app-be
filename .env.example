# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# Port the Express API listens on (local dev).
PORT=4000
# Runtime mode: "development" | "production". Controls log format and cookie security.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL — required)
# ─────────────────────────────────────────────────────────────
# Connection string the app uses at runtime.
# Local Postgres example below; for Supabase use the transaction pooler (pgbouncer, port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_app?schema=public
# Direct (non-pooled) connection used ONLY by Prisma Migrate / introspection.
# Required when DATABASE_URL points at a pooler. For local Postgres, set it equal to DATABASE_URL.
# Supabase: use the session pooler on port 5432.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hr_app?schema=public

# ─────────────────────────────────────────────────────────────
# Auth (required)
# ─────────────────────────────────────────────────────────────
# Secret used to sign admin JWTs — use a long, random string in every environment.
JWT_SECRET=replace-with-a-long-random-string
# How long an issued admin token stays valid (e.g. 8h, 1d).
JWT_EXPIRES_IN=8h

# ─────────────────────────────────────────────────────────────
# Seeded admin (the single HR-manager account, created by `npm run seed`)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@kpi.com
# Change this to a strong password before seeding any shared/online environment.
ADMIN_PASSWORD=change-me-strong

# ─────────────────────────────────────────────────────────────
# Resume storage — S3-compatible (AWS S3 or Supabase Storage)
# ─────────────────────────────────────────────────────────────
# Region of the bucket. AWS: e.g. us-east-1. Supabase: the project region, e.g. ap-southeast-1.
AWS_REGION=us-east-1
# Access key / secret for the bucket (private bucket — resumes are served via presigned URLs).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Name of the bucket that stores the uploaded resume PDFs.
S3_BUCKET=
# Set "true" to skip all S3 uploads (handy for local dev without a bucket). Default: false.
S3_SKIP=false
# Custom S3 endpoint. Leave EMPTY/unset for AWS S3.
# Only set when using Supabase Storage's S3-compatible API, e.g.
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
# Comma-separated allow-list of front-end origins (the public candidate form + the admin dashboard).
# Use "*" only for quick local testing — set explicit origins in production.
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────
# Uploads
# ─────────────────────────────────────────────────────────────
# Max accepted resume size in megabytes.
MAX_UPLOAD_MB=10
